{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "jankx/tour-journey-destination-count",
    "title": "Số điểm đến (Journey)",
    "category": "jankx",
    "icon": "location-alt",
    "description": "Hiển thị số lượng term 'destination' đã gán cho hành trình (số điểm đến sẽ tham quan).",
    "textdomain": "jankx",
    "supports": {
        "html": false,
        "anchor": true,
        "align": ["wide", "full"],
        "color": {
            "text": true,
            "background": true,
            "gradients": true,
            "__experimentalDefaultControls": {
                "text": true,
                "background": true
            }
        },
        "typography": {
            "fontSize": true,
            "lineHeight": true,
            "fontFamily": true,
            "fontWeight": true,
            "fontStyle": true,
            "letterSpacing": true,
            "textTransform": true,
            "textDecoration": true,
            "__experimentalDefaultControls": {
                "fontSize": true
            }
        },
        "spacing": {
            "margin": true,
            "padding": true,
            "blockGap": true
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        }
    },
    "attributes": {
        "label": {
            "type": "string",
            "default": "điểm đến sẽ tham quan"
        },
        "icon": {
            "type": "string",
            "default": "📍"
        },
        "showIcon": {
            "type": "boolean",
            "default": true
        },
        "showLabel": {
            "type": "boolean",
            "default": true
        }
    },
    "editorScript": "file:./build/index.js"
}
